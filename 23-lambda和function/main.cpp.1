#include <iostream>
#include <functional>

class Math
{
  public:
    double power(double base, double exponent) const
    {
        double result = 1.0;
        for (int i = 0; i < static_cast<int>(exponent); ++i)
        {
            result *= base;
        }
        return result;
    }
};

int main()
{
    Math mathObj;

    // 绑定成员函数power，固定基数为2
    auto powerOf2 = std::bind(&Math::power, &mathObj, 2.0, std::placeholders::_1);

    std::cout << "2^3 = " << powerOf2(3) << std::endl; // 输出: 2^3 = 8

    return 0;
}
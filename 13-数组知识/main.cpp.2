#include <iostream>

// 自定义的字符串复制函数
char* my_strcpy(char* dest, const char* src)
{

    auto re = dest;
    while ((*src) != '\0')
    {
        *(dest++) = *(src++);
    }
    *dest = '\0';
    return re;
}

int main()
{
    const char* source = "Hello, World!";
    char destination[50]; // 确保目标有足够的空间

    my_strcpy(destination, source);

    std::cout << "Source: " << source << std::endl;
    std::cout << "Destination: " << destination << std::endl;

    return 0;
}
#include <iostream>
#include <memory>
#include <cstdio>
#include <filesystem>

struct FileDeleter
{
    void operator()(FILE* fp) const
    {
        if (fp)
        {
            std::cout << "Closing file." << std::endl;
            fclose(fp);
        }
    }
};

static constexpr auto file_deleter = [](FILE* f)
{
    if (f)
    {
        std::cout << "Closing file." << std::endl;

        fclose(f);
    }
};

int main()
{
    // {
    //     std::shared_ptr<FILE> filePtr(fopen("example.txt", "wb"), FileDeleter());
    //     if (filePtr)
    //     {
    //         std::cout << "File opened successfully." << std::endl;
    //         // 使用 filePtr 进行文件操作
    //         fprintf(filePtr.get(), "Hello, World!\n");
    //     }
    // } // 自动关闭文件

    std::cout << std::filesystem::current_path() << std::endl;
    {
        std::unique_ptr<FILE, decltype(file_deleter)> f1(fopen("example.txt", "wb"), file_deleter);
        if (f1)
        {
            {
                fprintf(f1.get(), "f1\n");
            }
        }
    }
    {
        std::shared_ptr<FILE> f2(fopen("example.txt", "ab"), file_deleter);
        if (f2)
        {
            {
                fprintf(f2.get(), "f2");
            }
        }
    }

    std::cout << "Exiting main..." << std::endl;
    return 0;
}
#include <algorithm>
#include <vector>

std::vector<int> my_sort(const std::vector<int>& nums)
{
    std::vector<int> result = nums;
    for (int j{}; j + 1 < result.size(); ++j)
    {
        for (int i{}; i + 1 < result.size() - j; ++i)
        {
            if (result[i] > result[i + 1])
            {
                std::swap(result[i], result[i + 1]);
            }
        }
    }
    return result;
}

int main()
{
    // 冒泡排序
    // int count{}; // 数字总数

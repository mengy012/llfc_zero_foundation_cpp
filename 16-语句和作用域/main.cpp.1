    std::vector<int> nums{5, 4, 3, 2, 1};
    // for (int i{}; i < count; ++i)
    // {
    //     int tmp{};
    //     std::cin >> tmp;
    //     nums.push_back(tmp);
    // }

    std::cout << "before sort nums: ";
    for (auto v : nums)
    {
        std::cout << v << ' ';
    }
    std::cout << std::endl;

    std::vector<int> result{my_sort(nums)};
    std::cout << "after sort nums: ";
    for (auto v : result)
    {
        std::cout << v << ' ';
    }
    std::cout << std::endl;
}
class Timer
{
  public:
    explicit Timer(const std::string& task_name);
    ~Timer() noexcept;

    Timer(const Timer&) = delete;
    Timer& operator=(const Timer&) = delete;
    Timer(Timer&&) = delete;
    Timer& operator=(Timer&&) = delete;

  private:
    std::string task_name_;
    std::chrono::steady_clock::time_point start_;
};

inline void print_hms_ms_ns(std::chrono::nanoseconds total)
{
    auto h = std::chrono::duration_cast<std::chrono::hours>(total);
    total -= h;

    auto m = std::chrono::duration_cast<std::chrono::minutes>(total);
    total -= m;

    auto s = std::chrono::duration_cast<std::chrono::seconds>(total);
    total -= s;

    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(total);
    total -= ms;

    auto micro_seconds = std::chrono::duration_cast<std::chrono::microseconds>(total);
    total -= micro_seconds;

    std::cout << h.count() << "h " << m.count() << "m " << s.count() << "s " << ms.count() << "ms " << micro_seconds.count() << "us " << total.count() << "ns\n";
}

inline Timer::Timer(const std::string& task_name) : task_name_(task_name), start_(std::chrono::steady_clock::now())
{
    setUtf8();
}

inline Timer::~Timer() noexcept
{
    std::chrono::steady_clock::time_point end;
    end = std::chrono::steady_clock::now();
    std::cout << "task:" << task_name_ << ' ';
    print_hms_ms_ns(end - start_);
}

class MemoryPool
{
  public:
    MemoryPool(size_t obj_size, size_t total_size) : total_size_{total_size}, obj_size_{obj_size}, pool_{new unsigned char[total_size]}
    {

        for (size_t i = 0; i < total_size / obj_size; i++)
        {
            free_list_.push(static_cast<void*>(pool_ + obj_size * i));
        }
    }

    void* pool_allocate()
    {
        // std::cout << "free: " << free_list_.size() << std::endl;
        if (free_list_.empty())
        {
            throw std::bad_alloc();
        }
        void* tmp = free_list_.top();
        free_list_.pop();
        return tmp;
    }

    void pool_free(void* p)
    {
        auto begin = static_cast<void*>(pool_);
        auto end = static_cast<void*>(pool_ + total_size_);

        if (p >= begin && p < end && !(static_cast<unsigned char*>(p) - pool_) % alignof(MemoryPool))
        {
            free_list_.push(p);
        }
    }
    ~MemoryPool()
    {
        delete[] pool_;
    }

    MemoryPool(const MemoryPool& other) = delete;
    MemoryPool& operator=(const MemoryPool& other) = delete;

  private:
    size_t total_size_{};
    size_t obj_size_{};
    unsigned char* pool_{nullptr};
    std::stack<void*> free_list_{};
};

